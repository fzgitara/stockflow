# ============================================================
# StockFlow environment variables — copy to .env and adjust.
# NEVER commit a real .env file (it is gitignored).
# ============================================================

# --- Database (PostgreSQL) ---
# Local dev via docker: docker run -d --name stockflow-db -p 5433:5432 \
#   -e POSTGRES_DB=stockflow -e POSTGRES_USER=stockflow -e POSTGRES_PASSWORD=stockflow postgres:17-alpine
DB_URL=jdbc:postgresql://localhost:5432/stockflow
DB_USER=stockflow
DB_PASSWORD=stockflow

# --- Auth ---
# HS256 signing key; MUST be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=480

# --- Business ---
# Invoice tax rate as a decimal fraction (0.11 = 11%)
TAX_RATE=0.11

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200

# --- Seed ---
# Set true to create the demo user + products on startup (see README)
SEED_ENABLED=true

# --- Server ---
SERVER_PORT=8080
